{
  "name": "a3-front",
  "private": true,
  "version": "1.0.0",
  "description": "A3 本地优先的个性化学习多智能体桌面应用",
  "author": "Wei kb <212667660@qq.com>",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:desktop": "vue-tsc -b && vite build --base=./",
    "preview": "vite preview",
    "test": "node --test electron/app-icon.test.mjs electron/runtime.test.mjs electron/desktop-state.test.mjs electron/desktop-diagnostics.test.mjs electron/tray-lifecycle.test.mjs electron/backend-lifecycle.test.mjs electron/ipc-contract.test.mjs electron/backend-proxy.test.mjs electron/model-config.test.mjs electron/model-profile-vault.test.mjs electron/model-config-controller.test.mjs electron/model-profile-controller.test.mjs electron/knowledge-import.test.mjs electron/knowledge-controller.test.mjs electron/pet-config.test.mjs electron/pet-controller.test.mjs electron/pet-renderer.test.mjs electron/pet-audio.test.mjs electron/pet-character-import.test.mjs electron/signed-release-config.test.mjs electron/signed-release-workflow.test.mjs && vitest run && npm run test:signatures && npm run test:release-artifacts && npm run test:prepare-backend && npm run test:release-secrets",
    "test:signing-config": "node --test electron/signed-release-config.test.mjs",
    "test:signatures": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/release/tests/signature-verification.test.ps1",
    "test:release-artifacts": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/release/tests/release-artifacts.test.ps1",
    "test:prepare-backend": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/release/tests/prepare-desktop-backend.test.ps1",
    "test:release-secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/release/tests/release-secrets.test.ps1",
    "desktop:dev": "npm run build:desktop && electron .",
    "desktop:pack": "npm run build:desktop && electron-builder --dir",
    "desktop:dist": "npm run build:desktop && electron-builder --win nsis",
    "desktop:dist:signed": "node scripts/release/validate-signing-env.mjs && npm run build:desktop && electron-builder --config electron-builder.signed.cjs --win nsis"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@noble/hashes": "^1.8.0",
    "axios": "^1.18.1",
    "canonicalize": "^2.1.0",
    "element-plus": "^2.14.3",
    "mermaid": "^11.16.0",
    "pinia": "^3.0.4",
    "sass": "1.83.4",
    "semver": "^7.7.2",
    "vue": "^3.5.39",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.4",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "electron": "32.3.3",
    "electron-builder": "25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "~6.0.2",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.5",
    "yazl": "^3.3.1"
  },
  "build": {
    "appId": "com.a3.learning.agent",
    "productName": "智学协作台",
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-backend",
        "to": "backend"
      }
    ],
    "win": {
      "icon": "electron/assets/app-icon.ico",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/assets/app-icon.ico",
      "installerHeaderIcon": "electron/assets/app-icon.ico",
      "uninstallerIcon": "electron/assets/app-icon.ico"
    }
  }
}
