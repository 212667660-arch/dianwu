# Choose one provider: openai (OpenAI, DeepSeek, compatible services) or anthropic.
MODEL_PROVIDER=openai
MODEL_API_KEY=replace-with-your-key
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-pro
APP_ENV=development
REQUEST_TIMEOUT_SECONDS=60
RESOURCE_CACHE_TTL_SECONDS=86400
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_PROVIDERS=sogou,duckduckgo,bing
API_RATE_LIMIT_PER_MINUTE=10
WEB_SEARCH_RATE_LIMIT_PER_MINUTE=30
DIAGNOSIS_HISTORY_MESSAGE_LIMIT=12
DIAGNOSIS_HISTORY_MAX_CHARACTERS=48000

# Production desktop mode: Electron main process must generate DESKTOP_TOKEN
# for every launch and send it to the backend through a protected channel.
# The backend refuses all business API calls when APP_ENV=production and this
# token is absent. Do not put a production API key into this example file.
DESKTOP_TOKEN=

# Local HTTP model gateways are disabled by default. Enable only for explicit
# development-only testing; production accepts public HTTPS gateways only.
ALLOW_LOCAL_MODEL_GATEWAY=false

# Anthropic example:
# MODEL_PROVIDER=anthropic
# MODEL_API_KEY=replace-with-your-key
# MODEL_BASE_URL=https://api.deepseek.com/anthropic
# MODEL_NAME=deepseek-v4-pro
# ANTHROPIC_VERSION=2023-06-01

# Legacy OPENAI_* and HY_* variables remain supported for existing setups.
